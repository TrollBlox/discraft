{
	"schemaVersion": 1,
	"id": "discraft",
	"version": "${version}",
	"name": "discraft",
	"description": "Chat in Minecraft through Discord",
	"authors": [
		"TrollBlox"
	],
	"contact": {
		"sources": "https://github.com/TrollBlox/discraft"
	},
	"license": "MIT",
	"icon": "assets/discraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.trollblox.Discraft"
		],
		"client": [
			"net.trollblox.client.DiscraftClient"
		],
		"fabric-datagen": [
			"net.trollblox.client.DiscraftDataGenerator"
		]
	},
	"mixins": [
		"discraft.mixins.json",
		{
			"config": "discraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}